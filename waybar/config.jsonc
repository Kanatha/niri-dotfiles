{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["custom/monitor", "niri/workspaces"],
    "modules-center": [],
    "modules-right": ["tray", "memory", "cpu", "niri/language", "clock#date", "clock#time", "custom/power"],

    "custom/monitor": {
        "exec": "~/.config/waybar/scripts/monitor.sh",
        "interval": "once",
        "signal": 8,
        "tooltip": false
    },

    "niri/workspaces": {
        "format": "{value}"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "cpu": {
        "interval": 5,
        "format": " {usage}%",
        "tooltip": false
    },

    "niri/language": {
        "format": "⌨ {long}",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/language_menu.xml",
        "menu-actions": {
            "dvorak": "niri msg action switch-layout 0",
            "qwerty": "niri msg action switch-layout 1",
            "qwertz": "niri msg action switch-layout 2"
        }
    },

    "clock#date": {
        "interval": 60,
        "format": "{:%a %d %b}",
        "tooltip-format": "{:%Y-%m-%d}"
    },

    "clock#time": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "logout": "~/.config/waybar/scripts/power-action.sh logout",
            "reboot": "~/.config/waybar/scripts/power-action.sh reboot",
            "shutdown": "~/.config/waybar/scripts/power-action.sh shutdown"
        }
    }
}
