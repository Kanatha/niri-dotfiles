{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["custom/monitor", "niri/workspaces"],
    "modules-center": ["custom/control"],
    "modules-right": ["tray", "pulseaudio", "battery", "custom/calendar", "clock#date", "clock#time", "custom/power"],

    "custom/monitor": {
        "exec": "~/.config/waybar/scripts/monitor.sh",
        "interval": "once",
        "signal": 8,
        "tooltip": false
    },

    // Center pill: night light / DND / unread notifications. Click (or
    // Mod+Grave) toggles the control center panel (~/.config/control-center),
    // which also holds RAM/CPU stats, the keyboard layout and notifications.
    "custom/control": {
        "exec": "~/.config/waybar/scripts/control.sh",
        "return-type": "json",
        "interval": 15,
        "signal": 9,
        "on-click": "~/.config/control-center/control-center.py"
    },

    "niri/workspaces": {
        "format": "{value}"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    // Left click: pick output device, right click: pick input device,
    // middle click: mute output, scroll: output volume.
    "pulseaudio": {
        "format": "{icon} {volume}%  {format_source}",
        "format-muted": "󰝟 muted  {format_source}",
        "format-bluetooth": "󰂯 {volume}%  {format_source}",
        "format-bluetooth-muted": "󰂲 muted  {format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "Out: {desc}",
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "~/.config/wofi/scripts/audio-picker.sh output",
        "on-click-right": "~/.config/wofi/scripts/audio-picker.sh input",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },

    // Next Google Calendar event. calendar.sh only reads the local cache
    // (filled by the gcal-refresh systemd timer and after every add/edit/
    // delete, which also sends signal 10), so running it every minute is
    // cheap and keeps the "soon" class / 10-min reminder on time.
    "custom/calendar": {
        "exec": "~/.config/waybar/scripts/calendar.sh",
        "return-type": "json",
        "interval": 60,
        "signal": 10,
        "on-click": "~/.config/wofi/scripts/gcal-agenda.sh",
        "on-click-right": "~/.config/wofi/scripts/gcal-add.sh"
    },

    "clock#date": {
        "interval": 60,
        "format": "{:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#eceff4'><b>{}</b></span>",
                "weeks": "<span color='#4c566a'>{}</span>",
                "weekdays": "<span color='#81a1c1'>{}</span>",
                "today": "<span color='#88c0d0'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-click-right": "shift_reset"
        }
    },

    "clock#time": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "logout": "~/.config/waybar/scripts/power-action.sh logout",
            "reboot": "~/.config/waybar/scripts/power-action.sh reboot",
            "shutdown": "~/.config/waybar/scripts/power-action.sh shutdown"
        }
    }
}
