width=30%
height=50%
location=top
layer=overlay
prompt=Clipboard

allow_markup=false
allow_images=true
image_size=100

matching=fuzzy
insensitive=true
hide_scroll=true
dynamic_lines=true

# Vim motions (replaces arrow keys, which wofi can only bind one key to per action)
key_down=Ctrl-j
key_up=Ctrl-k
key_left=Ctrl-h
key_right=Ctrl-l
